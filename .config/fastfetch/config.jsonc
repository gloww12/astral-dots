{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "blue",
      "2": "yellow"
    }
  },
  "display": {
    "color": {
      "keys": "",
      "title": "yellow"
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "format": "{name}"
    },
    "uptime",
    "packages",
    "shell",
    "wm",
    {
      "type": "theme",
      "format": "Orbital" // hardcoded
    }
  ]
}
